---
import { stats } from '../lib/cv';
---

<section class="strip" aria-label="Career at a glance">
  <div class="wrap">
    <ul>
      {
        stats.map((stat) => (
          <li>
            <p class="value">
              {stat.value}
              {stat.unit && <span class="unit">{stat.unit}</span>}
            </p>
            <p class="label">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .strip {
    padding-block: var(--space-m);
    border-block: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-raised) 60%, transparent);
  }

  ul {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  li {
    display: grid;
    gap: var(--space-3xs);
  }

  .value {
    display: flex;
    align-items: baseline;
    gap: 0.15em;
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .unit {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--amber);
  }

  .label {
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--text-muted);
    max-width: 24ch;
  }

  @media print {
    .strip {
      padding-block: 6pt;
    }

    ul {
      grid-template-columns: repeat(4, 1fr);
      gap: 8pt;
    }

    .value {
      font-size: 14pt;
    }

    .label {
      font-size: 7.5pt;
    }
  }
</style>
