---
import { certifications, certificationGroups, formatYear } from '../lib/cv';
---

<div class="layout">
  <div class="groups">
    {
      certificationGroups.map((group) => (
        <section class="group">
          <h3 class="eyebrow">{group.label}</h3>
          {group.note && <p class="note">{group.note}</p>}
          <ul>
            {group.items.map((item) => (
              <li class:list={['item', { expired: item.expired }]}>
                <span class="mark" aria-hidden="true" />
                <span class="text">
                  {item.url ? (
                    <a href={item.url} rel="noopener">
                      {item.name}
                    </a>
                  ) : (
                    item.name
                  )}
                  {item.issued && (
                    <span class="meta mono">
                      {formatYear(item.issued)}
                      {item.expired && <span class="flag">expired</span>}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <section class="courses card">
    <h3>Courses & training</h3>
    <ul>
      {certifications.courses.map((course) => <li>{course}</li>)}
    </ul>
    <p class="verify">Linked credentials are verifiable on Credly.</p>
  </section>
</div>

<style>
  .layout {
    display: grid;
    gap: var(--space-l);
  }

  @media (min-width: 58rem) {
    .layout {
      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  .groups {
    align-content: start;
  }

  @media (min-width: 42rem) {
    .groups {
      /* Columns rather than a grid, so uneven groups pack without dead space. */
      columns: 2;
      column-gap: var(--space-l);
    }
  }

  .group {
    break-inside: avoid;
  }

  .group + .group {
    margin-block-start: var(--space-m);
  }

  .note {
    margin-block-start: 2px;
    font-size: var(--step--2);
    color: var(--text-subtle);
  }

  .group ul {
    margin-block-start: var(--space-2xs);
    display: grid;
    gap: var(--space-2xs);
  }

  .item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* A summit marker: a small cairn-like triangle. */
  .mark {
    margin-block-start: 0.42em;
    width: 0;
    height: 0;
    border-inline: 5px solid transparent;
    border-block-end: 8px solid var(--accent);
  }

  .item.expired .mark {
    border-block-end-color: var(--text-subtle);
  }

  .text a {
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .text a:hover {
    color: var(--accent);
  }

  .meta {
    margin-inline-start: 0.5em;
    font-size: var(--step--2);
    color: var(--text-subtle);
    white-space: nowrap;
  }

  .flag {
    margin-inline-start: 0.4em;
    padding: 0.05em 0.45em;
    border-radius: var(--radius-pill);
    background: var(--amber-wash);
    color: var(--amber);
    font-size: var(--step--2);
  }

  .courses {
    padding: var(--space-s);
    align-content: start;
    align-self: start;
  }

  .courses h3 {
    font-size: var(--step-0);
  }

  .courses ul {
    margin-block-start: var(--space-2xs);
    display: grid;
    gap: var(--space-3xs);
  }

  .courses li {
    position: relative;
    padding-inline-start: var(--space-s);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .courses li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.68em;
    width: 7px;
    height: 1.5px;
    background: var(--border-strong);
  }

  .verify {
    margin-block-start: var(--space-s);
    padding-block-start: var(--space-2xs);
    border-block-start: 1px solid var(--border);
    font-size: var(--step--2);
    color: var(--text-subtle);
  }

  @media print {
    .layout {
      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
      gap: 12pt;
    }

    .groups {
      columns: 2;
      column-gap: 12pt;
    }

    .group {
      break-inside: avoid;
    }

    .group + .group {
      margin-block-start: 7pt;
    }

    .group ul {
      gap: 1.5pt;
    }

    .courses {
      padding: 5pt;
    }

    .courses ul {
      gap: 1.5pt;
    }

    .mark {
      border-block-end-color: #333 !important;
    }

    .flag {
      background: none;
      border: 0.5pt solid var(--amber);
    }

    .verify {
      margin-block-start: 5pt;
    }
  }
</style>
